# Copy to .env.lakebed.server (ignored by Git) and fill in. Never commit real values.

# Bearer secret for /api/agent/*. Use a long random value, such as: openssl rand -hex 24
AGENT_SECRET=

# Bearer secret for /api/refresh.
REFRESH_SECRET=

# GitHub token. Read-only access to public repositories is enough.
GITHUB_TOKEN=

# Lakebed user ids that may read private data, separated by commas.
# Sign in on the site and read "userId" in the Viewer block to find yours.
OWNER_IDS=
